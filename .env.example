#Backend (тут)

SECRET_KEY=your-secret-key-here
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Окружение
ENVIRONMENT=development

# Postgres (используется docker-compose)
POSTGRES_USER=minions
POSTGRES_PASSWORD=minions
POSTGRES_DB=minions
# Локально без docker — например:
# DATABASE_URL=postgresql+asyncpg://minions:minions@localhost:5432/minions

#Frontend (копировать в frontend/.env)

VITE_API_URL=/api
VITE_ACCESS_TOKEN_EXPIRE_MINUTES=30 #брать значение из ACCESS_TOKEN_EXPIRE_MINUTES
VITE_REFRESH_TOKEN_EXPIRE_DAYS=7 #брать значение из REFRESH_TOKEN_EXPIRE_DAYS